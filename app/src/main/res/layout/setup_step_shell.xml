<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Setup.Page">

    <LinearLayout style="@style/Setup.Page.Content">

        <TextView
            style="@style/Setup.Title"
            android:text="@string/setup_shell_title" />

        <TextView
            style="@style/Setup.Body"
            android:text="@string/setup_shell_body" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/shell_preview_card"
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="24dp">

            <TextView
                android:id="@+id/shell_preview"
                style="@style/Setup.TerminalPreview" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/shell_prompt_row"
                    style="@style/Setup.OptionRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="16dp">

                        <TextView
                            style="@style/Setup.OptionTitle"
                            android:text="@string/setup_shell_prompt" />

                        <TextView
                            style="@style/Setup.OptionDescription"
                            android:text="@string/setup_shell_prompt_desc" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/shell_prompt_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerInsetStart="16dp"
                    app:dividerInsetEnd="16dp" />

                <LinearLayout
                    android:id="@+id/shell_greeting_row"
                    style="@style/Setup.OptionRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="16dp">

                        <TextView
                            style="@style/Setup.OptionTitle"
                            android:text="@string/setup_shell_greeting" />

                        <TextView
                            style="@style/Setup.OptionDescription"
                            android:text="@string/setup_shell_greeting_desc" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/shell_greeting_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/shell_storage_divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerInsetStart="16dp"
                    app:dividerInsetEnd="16dp" />

                <LinearLayout
                    android:id="@+id/shell_storage_row"
                    style="@style/Setup.OptionRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="16dp">

                        <TextView
                            style="@style/Setup.OptionTitle"
                            android:text="@string/setup_shell_storage" />

                        <TextView
                            style="@style/Setup.OptionDescription"
                            android:text="@string/setup_shell_storage_desc" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/shell_storage_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
