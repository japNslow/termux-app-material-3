<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Setup.Page">

    <LinearLayout
        style="@style/Setup.Page.Content"
        android:layout_gravity="center_vertical">

        <TextView
            android:id="@+id/setup_logo"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="@drawable/setup_logo_background"
            android:gravity="center"
            android:text="&gt;_"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Setup.Title"
            android:layout_marginTop="32dp"
            android:text="@string/setup_welcome_title"
            android:textAppearance="?attr/textAppearanceDisplaySmall" />

        <TextView
            style="@style/Setup.Body"
            android:layout_marginTop="12dp"
            android:text="@string/setup_welcome_body" />

        <TextView
            style="@style/Setup.Feature"
            android:layout_marginTop="32dp"
            android:drawableStart="@drawable/ic_check"
            android:text="@string/setup_welcome_feature_packages" />

        <TextView
            style="@style/Setup.Feature"
            android:drawableStart="@drawable/ic_check"
            android:text="@string/setup_welcome_feature_tools" />

        <TextView
            style="@style/Setup.Feature"
            android:drawableStart="@drawable/ic_check"
            android:text="@string/setup_welcome_feature_design" />
    </LinearLayout>
</ScrollView>
