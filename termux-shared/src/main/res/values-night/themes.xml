<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
     Material 3 (Material You) dark themes.
     https://m3.material.io/develop/android/mdc-android
    -->

    <!--
     BaseActivity DayNight DarkActionBar theme.
     https://github.com/material-components/material-components-android/blob/1.12.0/lib/java/com/google/android/material/theme/res/values/themes.xml
    -->
    <style name="Theme.BaseActivity.DayNight.DarkActionBar" parent="Theme.Material3.Dark">
        <!-- Fallback brand colors for devices without dynamic color (Android < 12). -->
        <item name="colorPrimary">@color/m3_seed_primary_dark</item>
        <item name="colorOnPrimary">@color/m3_seed_on_primary_dark</item>
        <item name="colorPrimaryContainer">@color/m3_seed_primary_container_dark</item>
        <item name="colorOnPrimaryContainer">@color/m3_seed_on_primary_container_dark</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Text color. -->
        <item name="android:textColorLink">@color/blue_link_dark</item>

        <item name="alertDialogTheme">@style/ThemeOverlay.BaseDialog.DayNight</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.BaseDialog.DayNight</item>
    </style>

    <!-- BaseActivity DayNight NoActionBar theme. -->
    <style name="Theme.BaseActivity.DayNight.NoActionBar" parent="Theme.BaseActivity.DayNight.DarkActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>





    <!--
      BaseDialog DayNight theme.
      https://github.com/material-components/material-components-android/blob/1.12.0/lib/java/com/google/android/material/dialog/res/values/themes.xml
    -->
    <style name="ThemeOverlay.BaseDialog.DayNight" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <!-- Dialog title panel style. -->
        <item name="materialAlertDialogTitlePanelStyle">@style/BaseDialog.Title.Panel</item>

        <!-- Dialog message text style. -->
        <item name="materialAlertDialogBodyTextStyle">@style/BaseDialog.Message.Text.Dark</item>
    </style>

</resources>
